{
  "name": "sliderep",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start -a",
    "ios": "expo start -i",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild -p android --clean",
    "build:apk": "expo prebuild -p android --clean && cd android && ./gradlew assembleRelease",
    "build:apk:arm64": "expo prebuild -p android --clean && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:aab": "expo prebuild -p android --clean && cd android && ./gradlew bundleRelease",
    "build:local": "eas build -p android --profile preview --local",
    "lint": "expo lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "expo": "^58.0.19",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true
}
